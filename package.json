{
  "name": "room-layout-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15 || >=26"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter room-layout dev",
    "build": "pnpm --filter room-layout build",
    "analyze-bundle": "pnpm --filter room-layout analyze-bundle",
    "typecheck": "pnpm --filter room-layout typecheck",
    "bundle-budget": "pnpm --filter room-layout bundle-budget",
    "i18n:extract": "pnpm --filter room-layout i18n:extract",
    "i18n:check": "pnpm --filter room-layout i18n:check",
    "test": "pnpm --filter room-layout test",
    "test:run": "pnpm --filter room-layout test:run",
    "coverage": "pnpm --filter room-layout coverage",
    "test:e2e:install": "pnpm --filter room-layout test:e2e:install",
    "test:e2e": "pnpm --filter room-layout test:e2e",
    "test:e2e:headed": "pnpm --filter room-layout test:e2e:headed",
    "test:e2e:ui": "pnpm --filter room-layout test:e2e:ui",
    "preview": "pnpm --filter room-layout preview",
    "lint": "eslint . && pnpm --filter room-layout lint",
    "lint:fix": "eslint . --fix && pnpm --filter room-layout lint:fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "fix": "pnpm lint:fix && pnpm format:write",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "models:export": "pnpm --filter @room-layout/asset-tool models:export",
    "textures:export": "pnpm --filter @room-layout/asset-tool textures:export",
    "preflight": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test:run && pnpm run knip && pnpm run i18n:check && pnpm run build && pnpm run bundle-budget && pnpm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "knip": "^6.16.1",
    "prettier": "^3.8.3"
  }
}
